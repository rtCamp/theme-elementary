{
	"name": "rtcamp/elementary",
	"description": "A starter theme that facilitates a quick head start for developing new block-based themes along with a bunch of developer-friendly features.",
	"type": "wordpress-theme",
	"homepage": "https://rtcamp.com/",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/rtCamp/wp-framework.git",
			"no-api": true
		},
		{
			"type": "vcs",
			"url": "https://github.com/rtCamp/wp-phpcs.git",
			"no-api": true
		},
		{
			"type": "vcs",
			"url": "https://github.com/rtCamp/wp-phpstan.git",
			"no-api": true
		}
	],
	"require": {
		"php": ">=8.2",
		"rtcamp/wp-framework": "^1.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "1.2.0",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpunit/phpunit": "^9.5",
		"rtcamp/wp-phpcs": "^1.0",
		"rtcamp/wp-phpstan": "^1.0",
		"wp-cli/i18n-command": "^2.4",
		"wp-phpunit/wp-phpunit": "^6.0",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"platform": {
			"php": "8.2"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"rtCamp\\Theme\\Elementary\\": "inc/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"rtCamp\\Theme\\Elementary\\Tests\\": "tests/php/"
		}
	},
	"scripts": {
		"phpcs": "@php ./vendor/bin/phpcs",
		"phpcs:fix": "@php ./vendor/bin/phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"post-install-cmd": [
			"npm i"
		],
		"pot": "wp i18n make-pot . ./languages/elementary-theme.pot --domain=elementary-theme --include=\"inc,patterns,assets/build/js\""
	}
}
