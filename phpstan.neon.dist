# https://phpstan.org/config-reference
#
# The shared baseline loads szepeviktor/phpstan-wordpress exactly once, so
# composer.json tells extension-installer to ignore it. `level` below overrides
# the baseline's 5.
includes:
	- vendor/rtcamp/wp-phpstan/phpstan.neon.dist
	- phpstan-baseline.neon
parameters:
	# Rules
	treatPhpDocTypesAsCertain: false
	inferPrivatePropertyTypeFromConstructor: true
	checkExplicitMixedMissingReturn: true
	checkFunctionNameCase: true
	checkInternalClassCaseSensitivity: true
	checkTooWideReturnTypesInProtectedAndPublicMethods: true
	polluteScopeWithAlwaysIterableForeach: false
	polluteScopeWithLoopInitialAssignments: false
	reportAlwaysTrueInLastCondition: true
	reportStaticMethodSignatures: true
	reportWrongPhpDocTypeInVarTag: true

	dynamicConstantNames:
		- ELEMENTARY_THEME_DISABLE_BROWSER_SYNC
		- ELEMENTARY_THEME_ENABLE_TAILWIND

	bootstrapFiles:
		- phpstan-bootstrap.php
	# Configuration
	level: 8
	phpVersion:
		min: 80200
		max: 80500
	paths:
		- functions.php
		- inc/
	excludePaths:
		analyse:
			- tests/
			- vendor/
		analyseAndScan:
			# Optional: the Lint PHP job never runs `npm install`, so this path is
			# absent there and PHPStan treats a missing excludePath as a config error.
			- node_modules/ (?)
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
